# Goblins Yard POS — environment variables
# Copy to .env and fill in. Never commit the real .env.

# --- API (apps/api) ---
# Postgres connection string. Local Docker maps Postgres to host port 5433.
DATABASE_URL="postgresql://goblins:goblins@localhost:5433/goblins_pos?schema=public"

# JWT signing secret for 15-min access tokens. REQUIRED in production —
# the app must refuse to boot without a strong value (no dev fallback).
JWT_SECRET="change-me-to-a-long-random-string"

# API listen port (defaults to 3000).
PORT=3000

# Timezone for cron/session math (billing is Africa/Cairo).
TZ=Africa/Cairo

# Seed demo data on container start (true only for demo/dev; false in prod).
SEED_ON_START=false

# Comma-separated allowlist of web origins for CORS + WebSocket in production,
# e.g. https://pos.goblinsyard.com,https://admin.goblinsyard.com.
# Leave unset in local dev to allow localhost.
CORS_ORIGINS=

# Shared secret the headless print-service uses to join the realtime "print"
# room. Must be identical on the API and the print-service. Required in prod.
WS_SERVICE_TOKEN="change-me-to-a-long-random-string"

# --- Poster POS import/export integration (optional) ---
POSTER_ACCOUNT=goblinsyard
POSTER_TOKEN=

# --- Print service (apps/print-service) ---
# "live" prints to network ESC/POS printers (TCP 9100); anything else writes preview files.
PRINT_MODE=preview
# Directory for preview tickets/receipts when not in live mode.
PREVIEW_DIR=./print-previews
# API base URL the print service subscribes to for print jobs.
API_URL=http://localhost:3000
