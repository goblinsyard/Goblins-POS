{
  "framework": "vite",
  "installCommand": "cd apps/kds && npm install --legacy-peer-deps",
  "buildCommand": "cd apps/kds && ./node_modules/.bin/vite build",
  "outputDirectory": "apps/kds/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-af82.up.railway.app/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://api-production-af82.up.railway.app/ws/:path*"
    }
  ]
}