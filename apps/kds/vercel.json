{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "./node_modules/.bin/vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-af82.up.railway.app/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://api-production-af82.up.railway.app/ws/:path*"
    }
  ]
}