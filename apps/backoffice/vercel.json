{
  "framework": "vite",
  "installCommand": "cd apps/backoffice && npm install --legacy-peer-deps",
  "buildCommand": "cd apps/backoffice && ./node_modules/.bin/vite build",
  "outputDirectory": "apps/backoffice/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-af82.up.railway.app/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://api-production-af82.up.railway.app/ws/:path*"
    }
  ]
}