registry=https://registry.npmjs.org/
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
unsafe-perm=true

# Allow postinstall scripts for build-critical packages
approve-builds[]=@nestjs/core
approve-builds[]=@prisma/client
approve-builds[]=@prisma/engines
approve-builds[]=argon2
approve-builds[]=esbuild
approve-builds[]=prisma
